    {
      "name": "4. Break mode (sticky)",
      "item": [
        {
          "name": "Break state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/break",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "break"
              ]
            },
            "description": "Current sticky-failure state."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has broken flag\", () => pm.expect(pm.response.json()).to.have.property(\"broken\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Enable break mode (502)",
