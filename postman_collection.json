{
  "info": {
    "name": "demo-project API",
    "description": "Every endpoint of the Cloud Run demo service, with assertions.\n\nSet {{baseUrl}} to either http://localhost:8080 (local) or your Cloud Run URL:\n  gcloud run services describe demo-project --region asia-south1 --format='value(status.url)'\n\nThe folders are ordered so a top-to-bottom run leaves the service healthy: Break mode is enabled and then recovered within its own folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & info",
      "item": [
        {
          "name": "Dashboard (HTML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "The demo page. Renders itself from the API below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is HTML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));",
                  "pm.test(\"has title\", () => pm.expect(pm.response.text()).to.include(\"<title>demo-project</title>\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "200 normally; 500 when BREAK_HEALTH=true (rollback demo)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"status ok\", () => pm.expect(b.status).to.eql(\"ok\"));",
                  "pm.test(\"has version\", () => pm.expect(b.version).to.match(/^\\d+\\.\\d+\\.\\d+$/));",
                  "pm.test(\"timestamp parses\", () => pm.expect(Date.parse(b.timestamp)).to.not.be.NaN);",
                  "pm.collectionVariables.set(\"revision\", b.revision);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Service info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "info"
              ]
            },
            "description": "Version, revision, region, uptime, node version, env."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"node version present\", () => pm.expect(b.node).to.match(/^v\\d+/));",
                  "pm.test(\"uptime is a number\", () => pm.expect(b.uptimeSeconds).to.be.a(\"number\"));",
                  "console.log(\"revision:\", b.revision, \"| region:\", b.region);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "2. Items & echo",
      "item": [
        {
          "name": "List items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "description": "All items plus a count."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"count matches array\", () => pm.expect(b.count).to.eql(b.items.length));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get item 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "1"
              ]
            },
            "description": "A single seeded item."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get missing item (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "999"
              ]
            },
            "description": "Expect a 404 with a JSON error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"has error\", () => pm.expect(pm.response.json().error).to.eql(\"not found\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "description": "Creates an item and saves its id as {{itemId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"from postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"name echoed\", () => pm.expect(b.name).to.eql(\"from postman\"));",
                  "pm.test(\"starts not done\", () => pm.expect(b.done).to.be.false);",
                  "pm.collectionVariables.set(\"itemId\", b.id);",
                  "console.log(\"created item id:\", b.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get created item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Fetches the item created above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"id matches\", () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"itemId\"))));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create item - missing name (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "description": "Validation failure.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"explains why\", () => pm.expect(pm.response.json().error).to.eql(\"name is required\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete created item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "204 No Content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete again (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Already gone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Echo query string",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/echo?msg=hi&n=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "echo"
              ],
              "query": [
                {
                  "key": "msg",
                  "value": "hi"
                },
                {
                  "key": "n",
                  "value": "2"
                }
              ]
            },
            "description": "Reflects the query params back."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"echoes params\", () => pm.expect(pm.response.json().youSent).to.deep.include({ msg: \"hi\", n: \"2\" }));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
