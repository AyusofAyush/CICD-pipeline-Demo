# Copy to .env and fill in for LOCAL use only. .env is git-ignored.
# These same values are passed to Cloud Build as substitution variables,
# so nothing here is ever hardcoded in a committed file.

# Your GCP project ID (e.g. my-demo-project-123456)
PROJECT_ID=
# Cloud Run + Artifact Registry region (e.g. asia-south1, us-central1)
REGION=asia-south1
# Artifact Registry Docker repository name
AR_REPO=demo-project
# Cloud Run service name
SERVICE_NAME=demo-project
# GitHub account/org that owns the repo
GITHUB_OWNER=
# GitHub repository name
GITHUB_REPO=

# App-level: set to true to make /health return 500 (rollback demo only)
BREAK_HEALTH=false
